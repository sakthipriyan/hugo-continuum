{{- /*
  Search index. Built at publish time and fetched only by the search page, so
  it costs nothing on any other page.

  Body text is complete. It used to be cut at 1200 characters, which is past
  the opening of only a fifth of these pages -- a word in the body of a long
  post simply could not be found. Capping higher does not help: at 20000
  characters the index is already within 10% of its full size, because a few
  long pages dominate either way. Full text costs about 275KB gzipped, paid
  once, by a reader who has gone to the search page and typed something.
*/ -}}
{{- $docs := slice -}}
{{- range where .Site.RegularPages "Params.private" "!=" true -}}
  {{- $p := . -}}
  {{- $owner := partial "func/owning-section.html" $p -}}
  {{- $tags := slice -}}
  {{- $section := "" -}}
  {{- with $owner -}}
    {{- $section = .Title -}}
    {{- with .Params.taxonomy }}{{ with (index $p.Params .) }}{{ $tags = . }}{{ end }}{{ end -}}
  {{- end -}}
  {{- $kind := partial "func/page-kind.html" . -}}
  {{- /* Same icons the content cards use, so a result looks like the thing it
         points at. */ -}}
  {{- $icon := "📄" -}}
  {{- if eq $kind "books" }}{{ $icon = "📚" }}
  {{- else if eq $kind "blogs" }}{{ $icon = "📝" }}
  {{- else if eq $kind "slides" }}{{ $icon = "🎯" }}
  {{- else if eq $kind "tools" }}{{ $icon = "🛠️" }}
  {{- else if eq $kind "videos" }}{{ $icon = "🎥" }}
  {{- end -}}
  {{- $docs = $docs | append (dict
      "t" .Title
      "u" .RelPermalink
      "s" (or .Params.summary .Description .Summary | plainify | htmlUnescape | chomp | truncate 200)
      "g" $tags
      "k" ($kind | humanize | singularize)
      "i" $icon
      "n" $section
      "d" (cond .Date.IsZero "" (.Date.Format "2006-01-02"))
      "b" (.Plain | htmlUnescape | chomp)
  ) -}}
{{- end -}}
{{- $docs | jsonify -}}
